<!DOCTYPE html>
<html>
<head>
    <title>Cart</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include('../partials/navbar') %>

<% if(success){ %>

<div class="container mt-3">

    <div class="alert alert-success alert-dismissible fade show">

        <%= success %>

        <button
            class="btn-close"
            data-bs-dismiss="alert">
        </button>

    </div>

</div>

<% } %>

<div class="main-content">

<div class="container mt-5">

    <!-- <h1 class="mb-4">Your Cart</h1> -->

    <% if(cart.length === 0){ %>

    <div class="text-center py-5">

        <h2>Your Cart Is Empty</h2>

        <p class="text-muted">
            Just relex,let us help you find some <br>first class product
        </p>

        <a href="/products"
           class="btn btn-dark">
            Browse Products
        </a>

    </div>

    <% } %>

    <% let grandTotal = 0; %>

    <% cart.forEach(item => { %>

        <% let total = item.price * item.qty; %>

        <% grandTotal += total; %>
         <h2 class="navbar-brand fw-bold fs-3">Your Cart</h2>
        <div class="card shadow-sm border-0 rounded-4 mb-4">
  
            <div class="card-body">

                <div class="row align-items-center">

                    <div class="col-md-2 text-center">

                        <img
                            src="<%= item.image %>"
                            class="img-fluid rounded"
                            style="height:120px;object-fit:cover;">

                    </div>

                    <div class="col-md-4">

                        <h5>
                            <%= item.title %>
                        </h5>

                        <p class="text-muted mb-0">
                            ₹ <%= item.price %>
                        </p>

                    </div>

                    <div class="col-md-3">

                        <a href="/cart/decrease/<%= item.productId %>"
                           class="btn btn-outline-danger btn-sm">
                            -
                        </a>

                        <span class="mx-3 fw-bold">
                            <%= item.qty %>
                        </span>

                        <a href="/cart/increase/<%= item.productId %>"
                           class="btn btn-outline-success btn-sm">
                            +
                        </a>

                    </div>

                    <div class="col-md-2">

                        <h5 class="text-success">
                            ₹ <%= total %>
                        </h5>

                    </div>

                    <div class="col-md-1">

                        <a href="/cart/remove/<%= item.productId %>"
                           class="btn btn-danger btn-sm">
                            ✕
                        </a>

                    </div>

                </div>

            </div>

        </div>

    <% }) %>

    <% if(cart.length > 0){ %>

    <div class="card shadow border-0 rounded-4 mt-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

                <h3 class="text-success mb-0">
                    Grand Total: ₹ <%= grandTotal %>
                </h3>

                <div>

                    <a href="/cart/clear"
                       class="btn btn-danger me-2">
                        Clear Cart
                    </a>

                    <a href="/orders/place"
                       class="btn btn-success">
                        Place Order
                    </a>

                </div>

            </div>

        </div>

    </div>

    <% } %>

</div>

</div>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>